[TEMPLATE]
# ============================================================
# AgentLab environment template -- NAMES ONLY, never values.
#
# Values live in Infisical (source of truth since 2026-09-25), not in this repo
# and not day-to-day in .env.local. Local development:
#
#   install CLI   winget install infisical   (mac/linux: infisical.com/docs/cli/overview)
#   once          pnpm secrets:login         (infisical login)
#   once/clone    pnpm secrets:link          (infisical init, writes .infisical.json)
#   run           pnpm dev                   (wraps: infisical run --env=dev -- ...)
#   verify        pnpm secrets:check         (key names/presence/length only)
#   offline       pnpm dev:local             (reads .env.local from disk)
#
# .env.local remains a git-ignored temporary override, but under `infisical run`
# the injected value wins and disk can only fill gaps.
# Migration runbook: docs/operations/infisical-secrets-runbook.md
# ============================================================

# --- Database (Neon) ---
DATABASE_URL=postgres://...  # pooled connection string from the Neon console

# Neon free-plan keepalive (OPTIONAL): the compute auto-suspends after ~5 min
# of inactivity; each wake is a cold start. Set to ping SELECT 1 on an
# interval and stay warm during work hours. Cost math is in server/db.ts.
# NEON_KEEPALIVE_MINUTES=5

# --- Google Gemini auth (org policy: NO API keys) ---
# Service account: ais-gemini-key-c716673060c044c@718497644379.iam.gserviceaccount.com
# Preferred: keep the JSON key contents in Infisical as GOOGLE_SERVICE_ACCOUNT_JSON
# so no key file exists on disk. If a local file is unavoidable, save it as
# secrets/gemini-service-account.json (git-ignored).
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional: override the key-file location.
# GOOGLE_SERVICE_ACCOUNT_FILE=

# Optional: route model calls through Vertex AI instead of the consumer
# Gemini API (required if the Generative Language API is not enabled on the
# project but Vertex is). Scope switches to cloud-platform automatically.
# GOOGLE_AI_BASE_URL=https://us-central1-aiplatform.googleapis.com/v1beta1/projects/<PROJECT>/locations/us-central1
# GOOGLE_AI_OAUTH_SCOPE=https://www.googleapis.com/auth/cloud-platform
# GOOGLE_AI_MODEL=gemini-2.5-flash

# Consumer Gemini API key from AI Studio (aistudio.google.com/apikey): the
# practical primary path under Google's Secure-by-Default orgs, which block
# service-account KEY creation outright. The service account still wins when
# present (see above); only ONE of the two is needed, not both.
# GOOGLE_GENERATIVE_AI_API_KEY=

# --- Sessions ---
# COOKIE_SECRET=
# JWT_SECRET=

# --- Integration credentials (delivered by Infisical) ---
# HUBSPOT_PAT=
# INSTANTLY_API_KEY=
# ELEVENLABS_API_KEY=
# AGENTMAIL_API_KEY=
# BROWSERBASE_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# AUTONOMA_SHARED_SECRET=
# AUTONOMA_SIGNING_SECRET=

# --- Social publishing ---
# LINKEDIN_ACCESS_TOKEN=
# FACEBOOK_PAGE_TOKEN=
# INSTAGRAM_APP_SECRET=
# THREADS_APP_SECRET=

# --- Build-time frontend values (Vite) ---
# VITE_* values are baked in at BUILD time, not injected at runtime: they must
# be present in the shell that runs `pnpm build` (CI/CD) as well as in dev.
# Keep them in Infisical and export them in the build step.
# VITE_APP_ID=
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=

# --- Runtime marker (set by the wrapped scripts, not by hand) ---
# SECRETS_SOURCE=infisical   # makes injected values win over .env/.env.local
