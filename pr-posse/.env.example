# Required: Anthropic API key. Used by agentic-flow to power each reviewer agent.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model for all agents. Defaults to whatever agentic-flow
# picks. Examples: claude-sonnet-4-5, claude-haiku-4-5
# AGENT_MODEL=claude-sonnet-4-5
